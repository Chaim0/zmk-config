#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/modifiers.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        lower_tap_hold: lower_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&mo>;
        };

        mod_morph_morph: mod_morph_morph {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        lower_raise_adjust_default {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
                bindings = <
                    //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
                    //│  none    │  Q       │  W       │  F       │     P    │     B    │   │     J    │     L    │  U       │  Y       │  '       │  none    │
                        &none     &kp Q       &kp W      &kp F      &kp P      &kp B          &kp J      &kp L       &kp U       &kp Y       &kp SQT     &none
                    //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                    //│  none    │  LSHFT A │  LALT R  │  LCTRL S │  LGUI T  │  G       │   │  M       │  RGUI N  │  RCTRL E │  RALT I  │  RSHFT O │  -       │
                    &none       &hml LSHFT A &hml LALT R &hml LCTRL S &hml LGUI T &kp G         &kp M       &hmr RGUI N &hmr RCTRL E &hmr RALT I &hmr RSHFT O &kp MINUS 
                    //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                    //│  none    │  Z       │  X       │  C       │  D       │  V       │   │  K       │  H       │  , ;     │  .       │    /     │  none    │
                    &none       &kp Z       &kp X       &kp C       &kp D       &kp V         &kp K       &kp H       &mod_morph_morph &kp DOT     &kp FSLH    &none
                    //╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯
                    //                                 ╭──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────╮
                    //                                 │  ESC     │  LOW/TAB │  ENTER   │   │  SPACE   │  RAISE   │  RALT    │
                                                     &kp ESC     &lower_tap_hold LOWER TAB &kp ENTER     &kp SPACE   &mo RAISE   &kp RALT
                    //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
                >;
            };

        lower {
                bindings = <
                    //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
                    //│  trans   │  trans   │  trans   │  trans   │  trans   │  trans   │   │  FSLH    │  N7      │  N8      │  N9      │  BSLH    │  trans   │
                    &trans      &trans      &trans      &trans      &trans      &trans        &kp FSLH    &kp N7      &kp N8      &kp N9      &kp BSLH    &trans
                    //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                    //│  trans   │  trans   │  trans   │  trans   │  trans   │  trans   │   │  QMARK   │  N4      │  N5      │  N6      │  MINUS   │  trans   │
                    &trans      &trans      &trans      &trans      &trans      &trans        &kp QMARK   &kp N4      &kp N5      &kp N6      &kp MINUS   &trans
                    //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                    //│  trans   │  trans   │  trans   │  trans   │  trans   │  trans   │   │  EXCL    │  N1      │  N2      │  N3      │  DOT     │  trans   │
                    &trans      &trans      &trans      &trans      &trans      &trans        &kp EXCL    &kp N1      &kp N2      &kp N3      &kp DOT     &trans
                    //╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯
                    //                                 ╭──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────╮
                    //                                 │  trans   │  trans   │  trans   │   │  trans   │  trans   │  N0      │
                                                     &trans      &trans      &trans        &trans      &trans      &kp N0
                    //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
                >;
            };

        raise {
                bindings = <
                    //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
                    //│  trans   │  trans   │  trans   │  GRAVE   │  LBKT    │  RBKT    │   │  trans   │  trans   │  trans   │  trans   │  SQT     │  trans   │
                    &trans      &trans      &trans      &kp GRAVE   &kp LBKT    &kp RBKT      &trans      &trans      &trans      &trans      &kp SQT     &trans
                    //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                    //│  trans   │  trans   │  trans   │  DQT     │  LBRC    │  RBRC    │   │  trans   │  trans   │  trans   │  trans   │  SEMI    │  trans   │
                    &trans      &trans      &trans      &kp DQT     &kp LBRC    &kp RBRC      &trans      &trans      &trans      &trans      &kp SEMI    &trans
                    //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                    //│  trans   │  trans   │  trans   │  SQT     │  LPAR    │  RPAR    │   │  trans   │  trans   │  trans   │  trans   │  LBKT    │  trans   │
                    &trans      &trans      &trans      &kp SQT     &kp LPAR    &kp RPAR      &trans      &trans      &trans      &trans      &kp LBKT    &trans
                    //╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯
                    //                                 ╭──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────╮
                    //                                 │  trans   │  trans   │  trans   │   │  trans   │  trans   │  trans   │
                                                     &trans      &trans      &trans        &trans      &trans      &trans
                    //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
                >;
            };

        alternate {
                bindings = <
                    //╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
                    //│  BT_CLR  │  BT_SEL 0│  BT_SEL 1│  BT_SEL 2│  BT_SEL 3│  BT_SEL 4│   │  trans   │  trans   │  trans   │  trans   │  trans   │  trans   │
                    &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans      &trans      &trans      &trans      &trans      &trans
                    //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                    //│  trans   │  RGB_TOG │  RGB_HUI │  RGB_BRI │  trans   │  trans   │   │  trans   │  trans   │  trans   │  trans   │  trans   │  trans   │
                    &trans      &rgb_ug RGB_TOG &rgb_ug RGB_HUI &rgb_ug RGB_BRI &trans      &trans        &trans      &trans      &trans      &trans      &trans      &trans
                    //├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤   ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                    //│  trans   │  RGB_EFF │  RGB_HUD │  RGB_BRD │  trans   │  trans   │   │  trans   │  trans   │  trans   │  trans   │  trans   │  trans   │
                    &trans      &rgb_ug RGB_EFF &rgb_ug RGB_HUD &rgb_ug RGB_BRD &trans      &trans        &trans      &trans      &trans      &trans      &trans      &trans
                    //╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────┴──────────┴──────────┴──────────╯
                    //                                 ╭──────────┬──────────┬──────────╮   ╭──────────┬──────────┬──────────╮
                    //                                 │  trans   │  trans   │  trans   │   │  trans   │  trans   │  trans   │
                                                     &trans      &trans      &trans        &trans      &trans      &trans
                    //                                 ╰──────────┴──────────┴──────────╯   ╰──────────┴──────────┴──────────╯
                >;
            };
    };
};

&led_strip {
    chain-length = <27>;
};

